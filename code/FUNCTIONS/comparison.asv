function [ROI_ADCP, ROI_EXTRAP, ROI_EOF, COMP] = comparison(cfg);
fname_adcp_level_1 = fullfile(cfg.out.adcp_data, [cfg.obsTag '_adcp_level_1.mat']);
load(fname_adcp_level_1);

fname_adcp_level_2 = fullfile(cfg.out.adcp_data, [cfg.obsTag '_adcp_level_2.mat']);
load(fname_adcp_level_2);

fname_drifters_level_2 = fullfile(cfg.out.drifters_data, [cfg.name '_drifters_level_2.mat']);
S = load(fname_drifters_level_2);

% fname_drifters_level_1 = fullfile(cfg.out.drifters_data, [cfg.name '_drifters_level_1.mat']);
% D = load(fname_drifters_level_1);

if isfield(S,'drifters_level_2')
    drifters_level_2 = S.drifters_level_2;

elseif isfield(S,'trimmed')
    drifters_level_2 = S.trimmed;

else
    error('File does not contain drifters_level_1 or trimmed')
end


proj = projcrs(32119);

%% Unrotate the extrapolated and EOF data
[M,N] = size(adcp_level_2.u2_extrap);

U_col_extrap = reshape(adcp_level_2.u2_extrap,[],1);
V_col_extrap = reshape(adcp_level_2.v2_extrap,[],1);

uv2_extrap = [U_col_extrap,V_col_extrap]*adcp_level_2.rot_mat';
u2_extrap = uv2_extrap(:,1);
v2_extrap = uv2_extrap(:,2);

u2_extrap = reshape(u2_extrap,M,N);
v2_extrap = reshape(v2_extrap,M,N);


[M,N] = size(adcp_level_2.U_mapped);

U_col_EOF = reshape(adcp_level_2.U_mapped,[],1);
V_col_EOF = reshape(adcp_level_2.V_mapped,[],1);

uv2_EOF = [U_col_EOF,V_col_EOF]*adcp_level_2.rot_mat';
u2_EOF = uv2_EOF(:,1);
v2_EOF = uv2_EOF(:,2);

u2_EOF = reshape(u2_EOF,M,N);
v2_EOF = reshape(v2_EOF,M,N);

%% Extract ADCP data from structure

V1 = adcp_level_1.V_E;
V1_extrap = u2_extrap';
V1_EOF = u2_EOF;
% V_E = adcp_level_1.V_E;
V2 = adcp_level_1.V_N;
V2_extrap = v2_extrap';
V2_EOF = v2_EOF;
% V_N = adcp_level_1.V_N;
adcp_bins = adcp_level_1.bins;
extrap_bins = adcp_level_2.dbins_extrap;
eof_bins = adcp_level_2.zonh_grid;
% East_avg = adcp_level_1.East_avg;
% North_avg = adcp_level_1.North_avg;
pressure = adcp_level_1.pressure;
% north = adcp_level_1.north;
% east = adcp_level_1.east;
% f1 = adcp_level_1.f1;
% f2 = adcp_level_1.f2;
time = adcp_level_1.time;
qcFlag = adcp_level_1.qcFlag;

qcFlag = qcFlag';

%% Compare drifter velocities within ROI to ADCP products


I_loc = [34.05673145 -77.88949171];
[E_loc, N_loc] = projfwd(proj,I_loc(1),I_loc(2));

[numDeployments, numDrifters] = size(drifters_level_2);

thresh = 50;   % meters
noPointsCount = 0;


%% ------------------------------------------------------------
% Put ADCP products into one structure
% ------------------------------------------------------------

Products(1).name = 'ADCP';
Products(1).VE = V1;
Products(1).VN = V2;
Products(1).bins = adcp_bins;

Products(2).name = 'EXTRAP';
Products(2).VE = V1_extrap;
Products(2).VN = V2_extrap;
Products(2).bins = extrap_bins;

Products(3).name = 'EOF';
Products(3).VE = V1_EOF;
Products(3).VN = V2_EOF;
Products(3).bins = eof_bins;


%% ------------------------------------------------------------
% Define a common structure template
% ------------------------------------------------------------

R_template = struct( ...
    'inds', [], ...
    'inde', [], ...
    'East', [], ...
    'North', [], ...
    'Lat', [], ...
    'Lon', [], ...
    'v_e', [], ...
    'v_n', [], ...
    'V', [], ...
    'avg_V', [], ...
    'avg_ve', [], ...
    'avg_vn', [], ...
    'drifter_Time_dattime', [], ...
    'drifter_Time', [], ...
    'adcp_ve', [], ...
    'adcp_vn', [], ...
    'adcp_V', [], ...
    'last_idx', [], ...
    'V_topbin', [], ...
    'VE_topbin', [], ...
    'VN_topbin', [], ...
    'adcp_P', [], ...
    'qcflag', [], ...
    'adcp_bin', [], ...
    'adcp_Time_datnum', [], ...
    'adcp_Time_dattime', [], ...
    'adcp_dbins', []);


%% ------------------------------------------------------------
% Preallocate output structures
% ------------------------------------------------------------

ROI_ADCP   = repmat(R_template,numDeployments,numDrifters);
ROI_EXTRAP = repmat(R_template,numDeployments,numDrifters);
ROI_EOF    = repmat(R_template,numDeployments,numDrifters);


%% ------------------------------------------------------------
% Main loop
% ------------------------------------------------------------

for j = 1:numDeployments

    for i = 1:numDrifters

        D = drifters_level_2(j,i);


        %% Skip empty drifters

        if isempty(D.East) || isempty(D.North)
            continue
        end


        %% Find observations inside ROI

        dist = hypot(D.East - E_loc, D.North - N_loc);

        ROI_idx = dist <= thresh;


        if ~any(ROI_idx)

            fprintf('No points within threshold for j=%d, i=%d\n',j,i);

            noPointsCount = noPointsCount + 1;

            continue
        end


        %% Extract drifter data inside ROI

        dr.East  = D.East(ROI_idx);
        dr.North = D.North(ROI_idx);
        dr.Lat   = D.Lat(ROI_idx);
        dr.Lon   = D.Lon(ROI_idx);

        dr.v_e = D.v_e(ROI_idx);
        dr.v_n = D.v_n(ROI_idx);
        dr.V   = D.V(ROI_idx);

        dr.T = D.Date_and_time(ROI_idx);

        dr.T_datnum = datenum(dr.T);


        %% Find corresponding ADCP time interval

        dt1 = time - dr.T_datnum(1);
        [~,ind1] = min(abs(dt1));

        dt2 = time - dr.T_datnum(end);
        dt2(ind1) = inf;
        [~,ind2] = min(abs(dt2));


        inds = min(ind1,ind2);
        inde = max(ind1,ind2);


        %% Pressure and QC data for this interval

        P = pressure(inds:inde);

        nanflag = qcFlag(:,inds:inde);


        %% ----------------------------------------------------
        % Loop through ADCP / EXTRAP / EOF
        % ----------------------------------------------------

        for p = 1:numel(Products)

            % Start from fresh template every iteration
            R = R_template;


            %% Extract velocity product

            VE = Products(p).VE(:,inds:inde);
            VN = Products(p).VN(:,inds:inde);

            Vmag = hypot(VE,VN);

            bins = Products(p).bins;
            
            % Mean profiles during the drifter encounter
            Vmean  = mean(Vmag,2,'omitnan');
            VEmean = mean(VE,2,'omitnan');
            VNmean = mean(VN,2,'omitnan');


            %% ------------------------------------------------
            % Determine near-surface velocity
            % ------------------------------------------------

            switch Products(p).name


                %% ========================
                % Raw ADCP
                % =========================

                case 'ADCP'

                    valid_rows = ...
                        ~isnan(Vmag(:,1)) & ...
                        Vmag(:,1) ~= 0;


                    last_valid_idx = find(valid_rows,1,'last');


                    % Skip if no valid bins exist
                    if isempty(last_valid_idx)
                        continue
                    end


                    V_topbin = Vmean(last_valid_idx);


                    VE_topbin = VEmean(last_valid_idx);


                    VN_topbin = VNmean(last_valid_idx);


                    adcp_bin = bins(last_valid_idx);



                %% ========================
                % Extrapolated product
                % =========================

                case 'EXTRAP'

                    meanP = mean(P,'omitnan');

                    bin_depths = bins - meanP;


                    V_topbin = interp1( ...
                        bin_depths, ...
                        Vmean, ...
                        -0.5);


                    VE_topbin = interp1( ...
                        bin_depths, ...
                        VEmean, ...
                        -0.5);


                    VN_topbin = interp1( ...
                        bin_depths, ...
                        VNmean, ...
                        -0.5);



                %% ========================
                % EOF product
                % =========================

                case 'EOF'

                    meanP = mean(P,'omitnan');


                    bin_depths = ...
                        (bins .* meanP) - meanP;


                    V_topbin = interp1( ...
                        bin_depths, ...
                        mean(Vmag,2,'omitnan'), ...
                        -0.5);


                    VE_topbin = interp1( ...
                        bin_depths, ...
                        mean(VE,2,'omitnan'), ...
                        -0.5);


                    VN_topbin = interp1( ...
                        bin_depths, ...
                        mean(VN,2,'omitnan'), ...
                        -0.5);

            end


            %% ------------------------------------------------
            % Store common ADCP information
            % ------------------------------------------------

            R.adcp_ve = VE;
            R.adcp_vn = VN;
            R.adcp_V  = Vmag;

            R.V_topbin  = V_topbin;
            R.VE_topbin = VE_topbin;
            R.VN_topbin = VN_topbin;

            R.adcp_P = P;

            R.qcflag = nanflag;

            R.adcp_Time_datnum = time(inds:inde);

            R.adcp_Time_dattime = datetime( ...
                time(inds:inde), ...
                'ConvertFrom','datenum');

            R.adcp_dbins = bins;


            %% ------------------------------------------------
            % Raw ADCP structure also stores drifter information
            % ------------------------------------------------

            if strcmp(Products(p).name,'ADCP')

                R.inds = inds;
                R.inde = inde;

                R.East  = dr.East;
                R.North = dr.North;
                R.Lat   = dr.Lat;
                R.Lon   = dr.Lon;

                R.v_e = dr.v_e;
                R.v_n = dr.v_n;
                R.V   = dr.V;

                R.avg_V = mean( ...
                    dr.V, ...
                    'omitnan');

                R.avg_ve = mean( ...
                    dr.v_e, ...
                    'omitnan');

                R.avg_vn = mean( ...
                    dr.v_n, ...
                    'omitnan');

                R.drifter_Time_dattime = dr.T;

                R.drifter_Time = dr.T_datnum;

                R.last_idx = last_valid_idx;

                R.adcp_bin = adcp_bin;

            end


            %% ------------------------------------------------
            % Store result
            % ------------------------------------------------

            switch Products(p).name

                case 'ADCP'

                    ROI_ADCP(j,i) = R;


                case 'EXTRAP'

                    ROI_EXTRAP(j,i) = R;


                case 'EOF'

                    ROI_EOF(j,i) = R;

            end

        end

    end
end


%% ------------------------------------------------------------
% Check whether ANY drifters entered ROI
% ------------------------------------------------------------

if noPointsCount == (numDrifters * numDeployments)

    disp('No events where drifters pass within ROI');

    ROI_ADCP   = [];
    ROI_EXTRAP = [];
    ROI_EOF    = [];
    COMP       = [];

    return

end


%% Compare ALL the currents

drifter_V = [ROI_ADCP(:,:).avg_V ROI_ADCP(:,:).avg_V ROI_ADCP(:,:).avg_V]
adcp_V = [ROI_ADCP(:,:).V_topbin ROI_EXTRAP(:,:).V_topbin ROI_EOF(:,:).V_topbin]

r_V = corrcoef(drifter_V,adcp_V);
r_V_value = r_V(1,2)


drifter_ve = [ROI_ADCP(:,:).avg_ve ROI_ADCP(:,:).avg_ve ROI_ADCP(:,:).avg_ve]
adcp_VE = [ROI_ADCP(:,:).VE_topbin ROI_EXTRAP(:,:).VE_topbin ROI_EOF(:,:).VE_topbin]

r_VE = corrcoef(drifter_ve,adcp_VE);
r_VE_value = r_VE(1,2)

drifter_vn = [ROI_ADCP(:,:).avg_vn ROI_ADCP(:,:).avg_vn ROI_ADCP(:,:).avg_vn]
adcp_VN = [ROI_ADCP(:,:).VN_topbin ROI_EXTRAP(:,:).VN_topbin ROI_EOF(:,:).VN_topbin]

r_VN = corrcoef(drifter_vn,adcp_VN);
r_VN_value = r_VN(1,2)

%% Save these values to COMP structure

COMP.drifter_V = drifter_V;
COMP.adcp_V = adcp_V;
COMP.r_V_value = r_V_value;

COMP.drifter_ve = drifter_ve;
COMP.adcp_ve = adcp_VE;
COMP.r_VE_value = r_VE_value;

COMP.drifter_vn = drifter_vn;
COMP.adcp_vn = adcp_VN;
COMP.r_VN_value = r_VN_value;

%% Calculate rms
mean(abs(adcp_VE))
mean(abs(drifter_ve))
RMS_E = rms(drifter_ve-adcp_VE)
mean(abs(adcp_VN))
mean(abs(drifter_vn))
RMS_N = rms(drifter_vn-adcp_VN)
mean(abs(adcp_V))
mean(abs(drifter_V))
RMS_V = rms(drifter_V-adcp_V)

%% Seperate Comparison figures
adcp = figure;
scatter([ROI_ADCP(:,:).avg_V], [ROI_ADCP(:,:).V_topbin], 36, 'r', 'o', 'filled')
hold on
scatter([ROI_ADCP(:,:).avg_ve], [ROI_ADCP(:,:).VE_topbin], 36, 'b', 's', 'filled');
scatter([ROI_ADCP(:,:).avg_vn], [ROI_ADCP(:,:).VN_topbin], 36, 'g', '^', 'filled');
xlim([-0.4 0.4]);
ylim([-0.4 0.4]);
grid on
y = -.4:0.05:0.4;
x = -.4:0.05:0.4;
plot(x,y,'k');
legend('V', 'u', 'v','1:1 line', 'Location', 'best')
xlabel('Drifter Velocities (m/s)');
ylabel('ADCP Velocities (m/s)');
title('ADCP OBSERVATIONS');

exportgraphics(adcp, fullfile(cfg.out.comp_figures, ['_adcp_drifter_comp.pdf']), 'Resolution', 300);
exportgraphics(adcp, fullfile(cfg.out.comp_figures, ['_adcp_drifter_comp.png']), 'Resolution', 300);

extrap = figure;
scatter([ROI_ADCP(:,:).avg_V], [ROI_EXTRAP(:,:).V_topbin], 36, 'r', 'o', 'filled')
hold on
scatter([ROI_ADCP(:,:).avg_ve], [ROI_EXTRAP(:,:).VE_topbin], 36, 'b', 's', 'filled');
scatter([ROI_ADCP(:,:).avg_vn], [ROI_EXTRAP(:,:).VN_topbin], 36, 'g', '^', 'filled');
%xlim([-0.4 0.4]);
%ylim([-0.4 0.4]);
grid on
y = -.4:0.05:0.4;
x = -.4:0.05:0.4;
plot(x,y,'k');
legend('V', 'u', 'v','1:1 line', 'Location', 'best')
xlabel('Drifter Velocities (m/s)');
ylabel('ADCP Velocities (m/s)');
title('EXTRAPOLATED OBSERVATIONS');

exportgraphics(extrap, fullfile(cfg.out.comp_figures, ['_extrap_drifter_comp.pdf']), 'Resolution', 300);
exportgraphics(extrap, fullfile(cfg.out.comp_figures, ['_extrap_drifter_comp.png']), 'Resolution', 300);

EOF = figure;
scatter([ROI_ADCP(:,:).avg_V], [ROI_EOF(:,:).V_topbin], 36, 'r', 'o', 'filled')
hold on
scatter([ROI_ADCP(:,:).avg_ve], [ROI_EOF(:,:).VE_topbin], 36, 'b', 's', 'filled');
scatter([ROI_ADCP(:,:).avg_vn], [ROI_EOF(:,:).VN_topbin], 36, 'g', '^', 'filled');
%xlim([-0.4 0.4]);
%ylim([-0.4 0.4]);
grid on
y = -.4:0.05:0.4;
x = -.4:0.05:0.4;
plot(x,y,'k');
legend('V', 'u', 'v','1:1 line', 'Location', 'best')
xlabel('Drifter Velocities (m/s)');
ylabel('ADCP Velocities (m/s)');
title('EOF');

exportgraphics(EOF, fullfile(cfg.out.comp_figures, ['_eof_drifter_comp.pdf']), 'Resolution', 300);
exportgraphics(EOF, fullfile(cfg.out.comp_figures, ['_eof_drifter_comp.png']), 'Resolution', 300);

%% All together

All = figure;
scatter(drifter_V, adcp_V, 36, 'r', 'o', 'filled')
hold on
scatter(drifter_ve, adcp_VE, 36, 'b', 's', 'filled');
scatter(drifter_vn, adcp_VN, 36, 'g', '^', 'filled');
% xlim([-0.4 0.4]);
% ylim([-0.4 0.4]);
grid on
y = -.4:0.05:0.4;
x = -.4:0.05:0.4;
plot(x,y,'k');
legend('V', 'u', 'v','1:1 line', 'Location', 'best')
xlabel('Drifter Velocities (m/s)');
ylabel('ADCP Velocities (m/s)');
title('All data');

exportgraphics(All, fullfile(cfg.out.comp_figures, ['_all_drifter_comp.pdf']), 'Resolution', 300);
exportgraphics(All, fullfile(cfg.out.comp_figures, ['_all_drifter_comp.png']), 'Resolution', 300);
end